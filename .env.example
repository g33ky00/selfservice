# selfserviced — required
SS_CF_TOKEN=your_cloudflare_api_token       # scope: Cloudflare Tunnel Edit
SS_CF_ACCOUNT_ID=your_account_id
SS_CF_TUNNEL_ID=your_permanent_tunnel_uuid  # the tunnel running cloudflared --config-src cloudflare
SS_PUBLIC_HOST=ss.example.com              # hostname bound to the tunnel

# selfserviced — optional
SS_LISTEN_ADDR=127.0.0.1:8765             # default
SS_AUTH_SECRET=                           # HMAC-SHA256 shared secret with callers; empty = no auth
SS_STATE_DIR=                             # default: $HOME/.selfservice
SS_GOTTY_BIN=                             # required for SSH sessions; e.g. /usr/local/bin/gotty
SS_DEFAULT_TTL=900                        # seconds (default 15m)
SS_MAX_TTL=7200                           # seconds (default 2h)
